# Which Ada Worker this app talks to.
#
# Committed defaults for local development. To change the target without
# touching this file, create .env.local (gitignored) and set the same keys
# there; it wins over this file.
#
# ---------------------------------------------------------------------------
# Two ways to reach the Worker. Pick one.
# ---------------------------------------------------------------------------
#
# A) Through the dev proxy  (default, recommended)
#    Leave VITE_API_BASE_URL empty. The browser calls this app's own origin and
#    Vite forwards /agents to ADA_WORKER_ORIGIN. Same-origin, so no CORS is
#    needed, and it works against a deployed Worker as well as a local one.
#    Dev server only: the proxy does not exist in a production build.
#
# B) Direct from the browser
#    Set VITE_API_BASE_URL to the Worker origin. The proxy is skipped.
#    Requires CORS enabled on the Worker. This is the only option for a
#    production build, where there is no dev server to proxy through.

# --- A: proxy target. Ignored when VITE_API_BASE_URL is set. ---
ADA_WORKER_ORIGIN=http://localhost:8787

# Deployed Worker, for pointing the proxy at a remote environment:
# ADA_WORKER_ORIGIN=https://ada-agent.<your-subdomain>.workers.dev

# --- B: direct call. Empty means "use my own origin" (option A). ---
# Inlined into the bundle at build time, so changing it needs a rebuild.
VITE_API_BASE_URL=
