# Copy to .env.local to override the committed defaults in .env.
# .env.local is gitignored, so personal or deployment-specific targets live here.

# Local Worker (default)
ADA_WORKER_ORIGIN=http://localhost:8787
VITE_API_BASE_URL=

# Deployed Worker, still through the dev proxy (no CORS needed):
# ADA_WORKER_ORIGIN=https://ada-agent.<your-subdomain>.workers.dev
# VITE_API_BASE_URL=

# Deployed Worker, called directly from the browser (CORS required on the Worker):
# VITE_API_BASE_URL=https://ada-agent.<your-subdomain>.workers.dev
